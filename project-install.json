{
  "name": "PanPal",
  "internal_compatibility_name": "CardBridge",
  "description": "Windows voice, keyboard, pet, and Codex task companion for M5Stack Cardputer ADV",
  "repository": "https://github.com/sonicpic/panpal-cardputer",
  "platform": "Windows",
  "minimum_os": "Windows 10",
  "architectures": ["x86_64"],
  "hardware": {
    "name": "M5Stack Cardputer ADV",
    "chip": "ESP32-S3",
    "wifi": "2.4GHz",
    "bluetooth": "Bluetooth LE"
  },
  "prebuilt_install": {
    "source": "GitHub Releases",
    "artifacts": [
      "PanPal-<version>-setup.exe",
      "panpal-dapan-<firmware>-build<build>.bin",
      "SHA256SUMS.txt"
    ]
  },
  "source_build": {
    "bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\windows\\bootstrap.ps1",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\windows\\build.ps1"
  },
  "external_audio": {
    "package": "VB-CABLE",
    "writer": "CABLE Input",
    "microphone": "CABLE Output"
  },
  "permissions": [
    "windows_firewall_for_wifi",
    "bluetooth_pairing",
    "default_microphone_change",
    "codex_hook_trust_if_enabled"
  ],
  "network": {
    "tcp_port": 7788,
    "udp_port": 7789,
    "hook_port": 7790
  }
}
